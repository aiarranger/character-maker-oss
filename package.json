{
  "name": "@aiarranger/character-maker",
  "version": "0.1.0",
  "private": true,
  "description": "Character Studio: a browser-based 3D character creator that exports game-ready GLB (idle/walk/run/sword/hit, >< face).",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/aiarranger/character-maker-oss.git"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.1.3",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 4284",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 --port 4284",
    "typecheck": "tsc --noEmit",
    "test": "node --import ./tests/ts-resolve.mjs --test lib/character-maker/*.test.mjs && node --test tests/*.test.cjs",
    "assets:sync": "node tools/character-maker/sync-studio-runtime-assets.mjs",
    "assets:check": "node tools/character-maker/sync-studio-runtime-assets.mjs --check",
    "import:characters": "node tools/import-characters.mjs --from ../characters",
    "pack:vendor": "node tools/pack.mjs"
  },
  "dependencies": {
    "@react-three/drei": "^10.3.0",
    "@react-three/fiber": "^9.1.0",
    "next": "^15.3.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "three": "^0.178.0"
  },
  "devDependencies": {
    "@gltf-transform/core": "4.4.1",
    "@gltf-transform/extensions": "4.4.1",
    "@gltf-transform/functions": "4.4.1",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/three": "^0.178.0",
    "meshoptimizer": "1.0.1",
    "sharp": "0.34.5",
    "typescript": "^5.8.0"
  }
}
